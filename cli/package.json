{
  "name": "freellmapi",
  "version": "0.8.2",
  "description": "Set up coding agents to use a FreeLLMAPI gateway",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tashfeenahmed/freellmapi.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/tashfeenahmed/freellmapi/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/tashfeenahmed/freellmapi/issues"
  },
  "keywords": [
    "freellmapi",
    "llm",
    "openai-compatible",
    "claude-code",
    "codex",
    "aider",
    "cline",
    "coding-agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "freellmapi": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/config-files.js",
    "dist/config-files.d.ts",
    "dist/doctor.js",
    "dist/doctor.d.ts",
    "dist/keys.js",
    "dist/keys.d.ts",
    "dist/models.js",
    "dist/models.d.ts",
    "dist/tools.js",
    "dist/tools.d.ts",
    "dist/types.js",
    "dist/types.d.ts",
    "tools.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.18.0 <25.0.0"
  },
  "dependencies":,
    "overrides": {
        "@typescript-eslint/typescript-estree": {"minimatch": "^11.0.8"}
    } {
    "@vitest/coverage-v8": "5.1.0",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "shadcn": "1.0.0",
    "yaml": "^2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.12.2",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.36.0",
    "vitest": "^5.1.0"
  }
}
